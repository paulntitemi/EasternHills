# Flask app environment variables.
# Copy to .env for local dev. On Vercel, set these in the project's Environment Variables UI.

# Required in production
SECRET_KEY=change-me-to-a-long-random-string

# Admin API token (also add to the admin dashboard's VITE_ADMIN_TOKEN)
ADMIN_TOKEN=dev-token-change-me

# Comma-separated list of origins allowed to call /api/*
ADMIN_ORIGINS=http://localhost:5173

# Supabase (backend uses the SERVICE key, which bypasses RLS)
# Dashboard → Project Settings → API → Project URL and service_role secret
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
